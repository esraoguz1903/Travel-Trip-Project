@using Travel_Trip_Project.Models.Classes
@model List<Destination>
@{
    ViewBag.Title = "Rehber / Rota Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
    .table-modern {
        vertical-align: middle;
    }
    .table-modern thead th {
        background: #f8fafc;
        color: #64748b;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
        border-bottom: 2px solid #e2e8f0;
        padding: 15px;
    }
    .table-modern tbody td {
        padding: 15px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        font-weight: 500;
    }
    .dest-img-thumb {
        width: 60px; height: 60px;
        border-radius: 12px; object-fit: cover;
    }
    .badge-soft-success {
        background-color: rgba(76, 175, 80, 0.1);
        color: #4CAF50;
        border: 1px solid rgba(76, 175, 80, 0.2);
    }
    .badge-soft-warning {
        background-color: rgba(255, 152, 0, 0.1);
        color: #FF9800;
        border: 1px solid rgba(255, 152, 0, 0.2);
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold" style="color: #1A2B4C;"><i class="fas fa-map-marked-alt me-2"></i> Rota ve Destinasyonlar</h4>
    <a href="/Admin/AddDestination/" class="btn btn-primary" style="border-radius: 12px; padding: 10px 20px; font-weight: 600; background: #1A2B4C; border: none;">
        <i class="fas fa-plus me-2"></i> Yeni Rota Ekle
    </a>
</div>

<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-borderless table-modern mb-0">
            <thead>
                <tr>
                    <th>Görsel</th>
                    <th>Lokasyon Bilgisi</th>
                    <th>Ülke</th>
                    <th>Rozetler</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if(Model != null && Model.Any())
                {
                    foreach(var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@item.PlaceImage" class="dest-img-thumb" alt="@item.Place" onerror="this.src='https://via.placeholder.com/60x60?text=Gorsel+Yok'"/>
                            </td>
                            <td>
                                <div class="fw-bold text-dark" style="font-size: 1.05rem;">@item.Place</div>
                                <div class="text-muted" style="font-size: 0.85rem;"><i class="fas fa-coffee me-1"></i> @item.Cafe</div>
                            </td>
                            <td>
                                <span class="fw-bold" style="color: #1A2B4C;">
                                    <i class="fas fa-globe-europe me-1 text-muted"></i> 
                                    @(item.Country != null ? item.Country.Name : "Bilinmiyor")
                                </span>
                            </td>
                            <td>
                                @if(item.IsTop10)
                                {
                                    <span class="badge badge-soft-success px-2 py-1 mb-1 d-inline-block"><i class="fas fa-star me-1"></i> Top 10</span>
                                }
                                @if(item.IsBestPlace)
                                {
                                    <span class="badge badge-soft-warning px-2 py-1 d-inline-block"><i class="fas fa-heart me-1"></i> En İyi Yer</span>
                                }
                                @if(!item.IsTop10 && !item.IsBestPlace)
                                {
                                    <span class="text-muted" style="font-size: 0.8rem;">Rozet Yok</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/Admin/GetDestination/@item.Id" class="btn btn-sm btn-info text-white me-2" style="border-radius: 8px; padding: 8px 15px;"><i class="fas fa-edit"></i> Güncelle</a>
                                <a href="/Admin/DeleteDestination/@item.Id" class="btn btn-sm btn-danger" style="border-radius: 8px; padding: 8px 15px;" onclick="return confirm('Bu rotayı silmek istediğinize emin misiniz?');"><i class="fas fa-trash-alt"></i> Sil</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fas fa-map-signs mb-3" style="font-size: 3rem; opacity: 0.2;"></i>
                            <h5>Henüz bir destinasyon eklenmemiş</h5>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
