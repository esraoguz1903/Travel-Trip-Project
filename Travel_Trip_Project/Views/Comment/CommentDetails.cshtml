@model Travel_Trip_Project.Models.Classes.Comments
@{
    ViewBag.Title = "Yorum Detayı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .glass-card {
        background: rgba(255,255,255,0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.8);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
    .info-label {
        font-weight: 700; color: #64748b;
        font-size: 0.85rem; text-transform: uppercase;
        letter-spacing: 1px; margin-bottom: 5px;
    }
    .info-value {
        font-size: 1.05rem; color: #1A2B4C; font-weight: 600;
        background: #f8fafc; padding: 13px 18px;
        border-radius: 12px; border: 1px solid #e2e8f0;
    }
    .comment-body {
        background: #fff; padding: 25px; border-radius: 15px;
        border: 1px solid #e2e8f0; font-size: 1.05rem;
        line-height: 1.9; color: #334155; min-height: 150px;
    }
    .avatar-large {
        width: 60px; height: 60px;
        background: linear-gradient(135deg, #1A2B4C, #2196F3);
        color: white; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem; font-weight: bold;
    }
</style>

<div class="mb-4">
    <a href="/Comment/CommentList" class="text-muted text-decoration-none fw-bold"><i class="fas fa-arrow-left me-2"></i> Yorum Listesine Dön</a>
</div>

<div class="glass-card p-4 p-md-5">
    <!-- Header -->
    <div class="d-flex align-items-center mb-5 pb-4" style="border-bottom: 2px dashed #e2e8f0;">
        @{
            var fl = !string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0,1).ToUpper() : "?";
        }
        <div class="avatar-large shadow-sm me-4">@fl</div>
        <div>
            <h3 class="fw-bold mb-1" style="color:#1A2B4C;">@Model.UserName</h3>
            <div class="text-muted"><i class="fas fa-envelope me-2"></i>@Model.Mail</div>
        </div>
        <div class="ms-auto text-end">
            <a href="/Comment/DeleteComment/@Model.Id" class="btn btn-outline-danger" style="border-radius:10px; padding:10px 20px; font-weight:600;" onclick="return confirm('Bu yorumu silmek istediğinize emin misiniz?');">
                <i class="fas fa-trash-alt me-2"></i> Yorumu Sil
            </a>
        </div>
    </div>

    <div class="row">
        @if(Model.Blog != null)
        {
            <div class="col-12 mb-4">
                <div class="info-label">İlgili Blog Yazısı</div>
                <div class="info-value">
                    <i class="fas fa-pen-nib me-2 text-primary"></i>@Model.Blog.Title
                    <a href="/Comment/CommentsByBlog/@Model.BlogId" class="btn btn-sm btn-outline-primary ms-3" style="border-radius:8px; font-size:0.8rem;">Bu bloğun tüm yorumları</a>
                </div>
            </div>
        }

        <div class="col-12 mb-4">
            <div class="info-label">Yorum İçeriği</div>
            <div class="comment-body shadow-sm">@Model.Comment</div>
        </div>

        <div class="col-12 mt-2 text-center">
            <a href="mailto:@Model.Mail" class="btn btn-primary shadow" style="background:#1A2B4C; border:none; border-radius:12px; padding:14px 40px; font-weight:600; font-size:1.05rem;">
                <i class="fas fa-reply me-2"></i> Kullanıcıya Yanıtla (E-Posta)
            </a>
        </div>
    </div>
</div>
