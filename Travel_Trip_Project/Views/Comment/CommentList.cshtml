@using Travel_Trip_Project.Models.Classes
@model List<Comments>
@{
    ViewBag.Title = "Yorum Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
    .table-modern { vertical-align: middle; }
    .table-modern thead th {
        background: #f8fafc;
        color: #64748b;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
        border-bottom: 2px solid #e2e8f0;
        padding: 15px;
    }
    .table-modern tbody td {
        padding: 15px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        font-weight: 500;
    }
    .avatar-circle {
        width: 40px; height: 40px;
        background: linear-gradient(135deg, #1A2B4C, #2196F3);
        color: white; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; font-weight: bold; flex-shrink: 0;
    }
    .comment-row { transition: background 0.2s; }
    .comment-row:hover { background: #f8fafc !important; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold" style="color: #1A2B4C;"><i class="fas fa-comments me-2"></i> Yorum Yönetimi</h4>
    <span class="badge bg-primary px-3 py-2" style="border-radius: 8px; font-size: 0.9rem;">Toplam: @(Model != null ? Model.Count() : 0)</span>
</div>

<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table table-borderless table-modern mb-0">
            <thead>
                <tr>
                    <th>Yorumcu</th>
                    <th>Blog Yazısı</th>
                    <th>Yorum Özeti</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if(Model != null && Model.Any())
                {
                    foreach(var item in Model)
                    {
                        var fl = !string.IsNullOrEmpty(item.UserName) ? item.UserName.Substring(0,1).ToUpper() : "?";
                        <tr class="comment-row">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle shadow-sm">@fl</div>
                                    <div>
                                        <div class="fw-bold text-dark">@item.UserName</div>
                                        <div class="text-muted" style="font-size:0.82rem;"><i class="fas fa-at me-1"></i>@item.Mail</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if(item.Blog != null)
                                {
                                    <a href="/Comment/CommentsByBlog/@item.BlogId" class="badge bg-light text-dark text-decoration-none px-3 py-2" style="border-radius:8px; border:1px solid #e2e8f0;">
                                        <i class="fas fa-pen-nib me-1 text-primary"></i> @item.Blog.Title
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Blog bulunamadı</span>
                                }
                            </td>
                            <td>
                                <div class="text-muted" style="max-width:280px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                    @(item.Comment != null && item.Comment.Length > 45 ? item.Comment.Substring(0,45) + "..." : item.Comment)
                                </div>
                            </td>
                            <td class="text-end">
                                <a href="/Comment/CommentDetails/@item.Id" class="btn btn-sm btn-primary text-white me-2" style="border-radius:8px; padding:8px 14px;"><i class="fas fa-eye"></i> Oku</a>
                                <a href="/Comment/DeleteComment/@item.Id" class="btn btn-sm btn-danger" style="border-radius:8px; padding:8px 14px;" onclick="return confirm('Bu yorumu silmek istediğinize emin misiniz?');"><i class="fas fa-trash-alt"></i> Sil</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="fas fa-comment-slash mb-3" style="font-size:3rem; opacity:0.2;"></i>
                            <h5>Henüz yorum yapılmamış</h5>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
