@using Travel_Trip_Project.Models.Classes
@model List<Blog>
@{
    ViewBag.Title = "Ana Sayfa";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<style>
    /* ===== HERO SLIDER ===== */
    .hero-slider {
        position: relative;
        width: 100%;
        height: 90vh;
        min-height: 550px;
        overflow: hidden;
    }
    .hero-slide {
        display: none;
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        transition: opacity 0.8s ease;
    }
    .hero-slide.active { display: block; }
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(10,25,60,0.35) 0%, rgba(10,25,60,0.65) 100%);
    }
    .hero-content {
        position: absolute;
        bottom: 14%;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
        color: #ffffff !important;
        width: 90%;
        max-width: 820px;
    }
    .hero-content h1 {
        font-size: clamp(2rem, 5vw, 3.8rem);
        font-weight: 900;
        line-height: 1.15;
        color: #ffffff !important;
        text-shadow: 0 4px 20px rgba(0,0,0,0.4);
        margin-bottom: 16px;
        letter-spacing: -0.5px;
    }
    .hero-content p {
        font-size: 1.1rem;
        opacity: 0.92;
        font-weight: 300;
        margin-bottom: 28px;
        color: #ffffff !important;
        text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    }
    .hero-btn {
        display: inline-block;
        background: #f0a500;
        color: #1A2B4C;
        font-weight: 700;
        padding: 14px 36px;
        border-radius: 50px;
        text-decoration: none;
        font-size: 1rem;
        letter-spacing: 0.5px;
        transition: all 0.3s;
        box-shadow: 0 6px 20px rgba(240,165,0,0.4);
    }
    .hero-btn:hover { background: #fff; transform: translateY(-2px); }

    /* Slider dots */
    .hero-dots {
        position: absolute;
        bottom: 6%;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 10px;
    }
    .hero-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        background: rgba(255,255,255,0.45);
        cursor: pointer;
        transition: background 0.3s, transform 0.3s;
        border: none;
    }
    .hero-dot.active { background: #f0a500; transform: scale(1.3); }

    /* ===== INTRO ===== */
    .intro-section {
        padding: 80px 20px;
        text-align: center;
        background: #fff;
    }
    .intro-section h2 {
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        color: #1A2B4C;
        font-weight: 800;
        margin-bottom: 20px;
    }
    .intro-section p {
        font-size: 1.05rem;
        line-height: 1.9;
        color: #666;
        max-width: 820px;
        margin: 0 auto;
    }

    /* ===== BLOG CARDS ===== */
    .blog-section {
        background: #f8fafc;
        padding: 70px 20px;
    }
    .section-title {
        text-align: center;
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        color: #1A2B4C;
        font-weight: 800;
        margin-bottom: 50px;
        position: relative;
    }
    .section-title::after {
        content: '';
        display: block;
        width: 60px; height: 4px;
        background: #f0a500;
        border-radius: 2px;
        margin: 14px auto 0;
    }
    .blog-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        transition: transform 0.3s, box-shadow 0.3s;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .blog-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.12);
    }
    .blog-card-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
    }
    .blog-card-body {
        padding: 22px 24px 24px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .blog-card-date {
        font-size: 0.8rem;
        color: #f0a500;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }
    .blog-card-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1A2B4C;
        margin-bottom: 10px;
        line-height: 1.4;
    }
    .blog-card-desc {
        font-size: 0.9rem;
        color: #777;
        line-height: 1.7;
        flex: 1;
    }
    .blog-card-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 16px;
        color: #1A2B4C;
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        transition: gap 0.2s;
    }
    .blog-card-link:hover { gap: 10px; color: #f0a500; }
</style>

<!-- ===== HERO SLIDER ===== -->
<section class="hero-slider" id="heroSlider">
    @if (Model != null && Model.Any())
    {
        var slides = Model.Take(3).ToList();
        for (int i = 0; i < slides.Count; i++)
        {
            var slide = slides[i];
            <div class="hero-slide @(i == 0 ? "active" : "")"
                 style="background-image: url('@slide.BlogImage');">
                <div class="hero-overlay"></div>
                <div class="hero-content">
                    <h1>@slide.Title</h1>
                    <p>@(slide.Description != null && slide.Description.Length > 120 ? slide.Description.Substring(0, 120) + "..." : slide.Description)</p>
                    <a href="/Blog/MyBlog/" class="hero-btn">Tüm Yazıları Keşfet &rarr;</a>
                </div>
            </div>
        }
        <!-- Dots -->
        <div class="hero-dots">
            @for (int i = 0; i < slides.Count; i++)
            {
                <button class="hero-dot @(i == 0 ? "active" : "")" onclick="goToSlide(@i)"></button>
            }
        </div>
    }
    else
    {
        <div class="hero-slide active" style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1600');">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h1>Dünyanın Dört Bir Yanını Keşfet</h1>
                <p>Büyüleyici rotalar, gizli kalmış köşeler ve unutulmaz anılar sizi bekliyor.</p>
                <a href="/Blog/MyBlog/" class="hero-btn">Yazıları Keşfet &rarr;</a>
            </div>
        </div>
    }
</section>

<!-- ===== INTRO ===== -->
<section class="intro-section">
    <div class="container">
        <h2>Tatil Seyahat Bloğuma Hoşgeldiniz ✈️</h2>
        <p>
            Dünyanın dört bir yanındaki gizli kalmış köşeleri, büyüleyici manzaraları ve unutulmaz anıları keşfetmek için
            en doğru yerdesiniz! Bu blogda kalabalık şehirlerin tarihi sokaklarında kaybolacak, doğanın kalbinde huzur
            bulacağımız rotaları birlikte çizeceğiz. Seyahat ipuçları, yöresel lezzetler ve ilham veren hikayeler burada.
        </p>
    </div>
</section>

<!-- ===== BLOG CARDS ===== -->
<section class="blog-section">
    <div class="container">
        <h2 class="section-title">Son Blog Yazıları</h2>
        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var x in Model.OrderByDescending(x => x.Id).Take(3).ToList())
                {
                    <div class="col-md-6 col-lg-4 mb-4 d-flex">
                        <div class="blog-card w-100">
                            <img src="@x.BlogImage" alt="@x.Title" class="blog-card-img"
                                 onerror="this.src='https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=600'" />
                            <div class="blog-card-body">
                                <div class="blog-card-date">
                                    <i class="fas fa-calendar-alt me-1"></i> @x.BlogDate.ToString("dd MMMM yyyy")
                                </div>
                                <div class="blog-card-title">@x.Title</div>
                                <div class="blog-card-desc">
                                    @(x.Description != null && x.Description.Length > 100 ? x.Description.Substring(0, 100) + "..." : x.Description)
                                </div>
                                <a href="/Blog/MyBlog/" class="blog-card-link">
                                    Devamını Oku <span>&rarr;</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@Html.Action("Partial1", "Default")

<script>
    var currentSlide = 0;
    var slides = document.querySelectorAll('.hero-slide');
    var dots = document.querySelectorAll('.hero-dot');
    var total = slides.length;

    function goToSlide(n) {
        slides[currentSlide].classList.remove('active');
        dots[currentSlide].classList.remove('active');
        currentSlide = n;
        slides[currentSlide].classList.add('active');
        dots[currentSlide].classList.add('active');
    }

    if (total > 1) {
        setInterval(function () {
            goToSlide((currentSlide + 1) % total);
        }, 5000);
    }
</script>

