@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Travel Trip Admin Paneli</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f4f7fa;
            overflow-x: hidden;
            color: #2b3648;
        }

        /* Yüzen, Modern Sidebar */
        .sidebar {
            height: calc(100vh - 40px);
            background: #1A2B4C;
            background-image: radial-gradient(circle at top right, rgba(255,255,255,0.05) 0%, transparent 40%);
            color: #fff;
            position: fixed;
            top: 20px;
            left: 20px;
            width: 260px;
            z-index: 999;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(26, 43, 76, 0.15);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }

        .sidebar-header {
            padding: 35px 20px 25px;
            text-align: center;
        }

        .sidebar-header h3 {
            margin: 0;
            font-weight: 800;
            font-size: 22px;
            letter-spacing: -0.5px;
            background: linear-gradient(45deg, #fff, #a0bdec);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sidebar ul.components {
            padding: 10px 15px;
            flex-grow: 1;
        }

        .sidebar ul li {
            margin-bottom: 8px;
        }

        .sidebar ul li a {
            padding: 14px 20px;
            font-size: 0.95em;
            display: flex;
            align-items: center;
            color: rgba(255, 255, 255, 0.65);
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 500;
            border-radius: 14px;
        }

        .sidebar ul li a i {
            margin-right: 15px;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1em;
            border-radius: 8px;
            background: rgba(255,255,255,0.05);
            transition: all 0.3s ease;
        }

        .sidebar ul li a:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.05);
            transform: translateX(5px);
        }

        .sidebar ul li.active > a {
            color: #1A2B4C;
            background: #fff;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            font-weight: 700;
        }

        .sidebar ul li.active > a i {
            background: #1A2B4C;
            color: #fff;
        }

        /* Page Content Styling */
        .page-content {
            margin-left: 280px; /* Sidebar width + margin */
            padding: 20px 30px 30px 20px;
            min-height: 100vh;
        }

        /* Top Navbar */
        .top-navbar {
            background-color: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            padding: 15px 30px;
            margin-bottom: 35px;
            border-radius: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid rgba(255,255,255,0.5);
            box-shadow: 0 10px 30px rgba(0,0,0,0.02);
            position: sticky;
            top: 20px;
            z-index: 998;
        }

        .top-navbar .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
            background: #fff;
            padding: 6px 6px 6px 20px;
            border-radius: 50px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: 1px solid #f0f4f8;
        }

        .top-navbar .user-profile img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }
    </style>
</head>
<body>

    <div class="d-flex">
        <!-- Modern Floating Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <h3><i class="fas fa-paper-plane me-2" style="color: #fff; -webkit-text-fill-color: initial;"></i>TravelApp</h3>
            </div>

            <ul class="list-unstyled components">
                <li class="active">
                    <a href="/Admin/AdminHome"><i class="fas fa-layer-group"></i> Dashboard</a>
                </li>
                <li class="mt-4 mb-2 ms-3 text-uppercase" style="font-size: 0.7em; color: rgba(255,255,255,0.4); font-weight: 700; letter-spacing: 1px;">İçerik Yönetimi</li>
                <li>
                    <a href="/Admin/HomeList"><i class="fas fa-home"></i> Ana Sayfa Ayarları</a>
                </li>
                <li>
                    <a href="/Admin/AboutList"><i class="fas fa-info-circle"></i> Hakkımızda</a>
                </li>
                <li>
                    <a href="/Admin/DestinationList"><i class="fas fa-map-marked-alt"></i> Rehber / Rotalar</a>
                </li>
                <li>
                    <a href="/Admin/BlogList"><i class="fas fa-pen-nib"></i> Blog Yazıları</a>
                </li>

                <li class="mt-4 mb-2 ms-3 text-uppercase" style="font-size: 0.7em; color: rgba(255,255,255,0.4); font-weight: 700; letter-spacing: 1px;">Etkileşim</li>
                <li>
                    <a href="/Admin/ContactList"><i class="fas fa-envelope-open-text"></i> İletişim Mesajları</a>
                </li>
                <li>
                    <a href="/AdminLogin/Logout"><i class="fas fa-envelope-open-text"></i> Çıkış Yap</a>
                </li>
            </ul>

            <div style="padding: 20px;">
                <a href="/Default/Home/" target="_blank" class="btn btn-light w-100 fw-bold" style="border-radius: 14px; padding: 12px; color: #1A2B4C; background: rgba(255,255,255,0.9);">
                    <i class="fas fa-globe me-2"></i> Siteyi Görüntüle
                </a>
            </div>
        </nav>

        <!-- Page Content -->
        <div class="page-content w-100">
            <!-- Modern Top Navbar -->
            <div class="top-navbar">
                <div>
                    <h4 class="m-0 fw-bolder" style="color: #1A2B4C; letter-spacing: -0.5px;">@ViewBag.Title</h4>
                    <span style="font-size: 0.85em; color: #6b7c93; font-weight: 500;">Travel Trip Modern Yönetim Arayüzü</span>
                </div>
                <div class="user-profile">
                    <div class="text-end d-none d-md-block">
                        <div class="fw-bold" style="color: #1A2B4C; font-size: 0.9em;">Esra Oğuz</div>
                        <div style="font-size: 0.75em; color: #6b7c93; font-weight: 600;">Sistem Yöneticisi</div>
                    </div>
                    <img src="https://ui-avatars.com/api/?name=Esra+Oguz&background=1A2B4C&color=fff&bold=true" alt="Admin">
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="content-area">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
