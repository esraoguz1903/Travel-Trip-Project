@using Travel_Trip_Project.Models.Classes
@model List<Blog>

@{
    ViewBag.Title = "MyBlog";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<!-- Tips & tricks-->
<section class="section novi-background bg-cover bg-default text-center" style="padding-top: 40px; padding-bottom: 50px;">
    <div class="container-wide">
        <div class="row row-30">
            <div class="col-sm-12">
                <h3 style="color: #1A2B4C; margin-bottom: 20px;">BLOGLARIM</h3>
                
                <!-- Owl Carousel-->
                <div class="owl-carousel owl-carousel-team owl-carousel-inset" data-items="1" data-md-items="2" data-xl-items="3" data-stage-padding="15" data-loop="true" data-margin="30" data-mouse-drag="false" data-dots="true" data-autoplay="true">
                    @foreach (var x in Model.Take(3))
                    {
                        <article class="post-blog">
                            <a class="post-blog-image"><img src=@x.BlogImage alt="" width="400" height="350" /></a>
                            <div class="post-blog-caption">
                                <div class="post-blog-caption-header">
                                    <ul class="post-blog-tags">
                                        <li><a class="button-tags" href="#">Hotels</a></li>
                                    </ul>
                                    <ul class="post-blog-meta">
                                        <li><span>by</span>&nbsp;<a href="#">Esra Oğuz</a></li>
                                    </ul>
                                </div>
                                <div class="post-blog-caption-body">
                                    <h5><a class="post-blog-title">@x.Title</a></h5>
                                    <p>@x.Description.Substring(0, 125)...</p>
                                </div>
                                <div class="post-blog-caption-footer" style="display: flex; justify-content: space-between; align-items: center;">
                                    <time><i class="mdi mdi-calendar"></i> @x.BlogDate.ToString("dd.MM.yyyy")</time>
                                    <a href="/Blog/BlogDetails/@x.Id" style="color: #1A2B4C; font-weight: bold; font-size: 0.9rem;">Devamını Oku <i class="mdi mdi-arrow-right"></i></a>
                                </div>
                            </div>
                        </article>
                    }
                    </div>
                
            </div>
            <div class="col-12"><a class="button button-secondary button-nina button-offset-lg" href="/Blog/BlogList/">Tüm Blogları Görüntüle</a></div>
        </div>
    </div>
</section>

